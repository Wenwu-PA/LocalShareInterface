# Copy to .env.go next to config.go.yaml. Never commit real secret values.
# The process environment takes precedence. Restart after changing this file.
LANBRIDGE_TELEGRAM_TOKEN=
LANBRIDGE_TELEGRAM_CHAT=
LANBRIDGE_WEBHOOK_URL=
# SMTP URL format: smtps://mail.example.com:465 or smtp://mail.example.com:587
LANBRIDGE_SMTP_URL=
LANBRIDGE_SMTP_USER=
LANBRIDGE_SMTP_PASSWORD=
LANBRIDGE_SMTP_FROM=
LANBRIDGE_SMTP_TO=
# Configure the external observer to alert after 90 seconds without a signal.
LANBRIDGE_OBSERVER_URL=

# Optional path to cloudflared. External access always starts disabled.
# LANBRIDGE_GO_CLOUDFLARED=C:/Tools/cloudflared.exe
